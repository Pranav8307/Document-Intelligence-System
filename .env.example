# Copy to .env and edit. Never commit .env.
USE_MOCK_LLM=true
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Optional: PostgreSQL URL for persistence
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/document_intelligence
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
